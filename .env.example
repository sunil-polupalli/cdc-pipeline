# ─────────────────────────────────────────────
# CDC Pipeline – Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit the .env file to version control.
# ─────────────────────────────────────────────

# ── MySQL ──────────────────────────────────────
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=inventory
MYSQL_USER=appuser
MYSQL_PASSWORD=apppassword
MYSQL_HOST=mysql
MYSQL_PORT=3306

# ── Debezium replication user ──────────────────
# This user is created by mysql/init/03-users.sql
DEBEZIUM_USER=debezium_user
DEBEZIUM_PASSWORD=debezium_pw

# ── Kafka ──────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_GROUP_ID=cdc-processor-group

# ── Kafka Connect ──────────────────────────────
KAFKA_CONNECT_URL=http://connect:8083

# ── Processor tuning ───────────────────────────
# Number of records to buffer before flushing to Parquet
FLUSH_BATCH_SIZE=200
# Max seconds to hold a buffer before flushing regardless of size
FLUSH_INTERVAL_SEC=30
# How often (seconds) to regenerate the lineage report
LINEAGE_REPORT_INTERVAL_SEC=60

# ── Path overrides (inside containers) ────────
SCHEMA_DB_PATH=/state/schemas.db
DATA_LAKE_ROOT=/data_lake
LINEAGE_REPORT_PATH=/output/lineage_report.json
